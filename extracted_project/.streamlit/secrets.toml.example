# OpenLearn AI - Streamlit Secrets Template
#
# LOCAL USAGE:
# Rename this file to 'secrets.toml' inside '.streamlit/' directory
#
# STREAMLIT COMMUNITY CLOUD DEPLOYMENT:
# In your app dashboard -> Settings -> Secrets, paste these keys:

# Recommended (Free & Ultra-Fast inference for live hackathon demos)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Optional alternatives:
GEMINI_API_KEY = "AIza_your_gemini_api_key_here"
OPENAI_API_KEY = "sk_your_openai_api_key_here"
