# OpenLearn AI — Environment Variables & API Key Configuration Template
# Copy this file to .env and add your API keys:

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq Cloud API Key (Get a free sub-second key at https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API Key (Multi-model hub with free models at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434
